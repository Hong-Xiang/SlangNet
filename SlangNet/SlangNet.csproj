<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableComHosting>true</EnableComHosting>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>

    <!-- Platform Support -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>

    <!-- NuGet Package Settings -->
    <PackageId>SlangNet</PackageId>
    <Version>0.0.1</Version>
    <Company>SlangNet</Company>
    <Product>SlangNet</Product>
    <Description>A .NET binding for the Slang shader compiler with COM interop. Currently supports
      Windows x64 only.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hong-Xiang/SlangNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hong-Xiang/SlangNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>slang;shader;compiler;hlsl;glsl;spirv;windows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DualDrill.SlangNet.Native" Version="2025.19.1-alpha.1" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>